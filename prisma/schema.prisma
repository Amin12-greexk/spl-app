// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Blok ENUM sudah dihapus

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  password               String
  pin                    String
  name                   String
  role                   String             @default("STAFF") // STAFF, HR, MANAGER, GA, DEPARTMENT_HEAD, PRODUCTION_SUPERVISOR, TEKNISI, DRIVER, SUPER_ADMIN
  departmentName         String?            @map("department")
  departmentId           String?
  department             Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  position               String? // Security, IT Staff, Admin, etc
  regularStartTime       String? // Jam kerja reguler mulai (HH:MM)
  regularEndTime         String? // Jam kerja reguler selesai (HH:MM)
  supervisorId           String? // ID atasan langsung
  supervisor             User?              @relation("SupervisorRelation", fields: [supervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates           User[]             @relation("SupervisorRelation")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  splRequests            Spl[]              @relation("requester")
  splApprovals           Spl[]              @relation("approver")
  splSupervisorApprovals Spl[]              @relation("supervisor")
  notifications          UserNotification[]
  securityShiftAssignments SecurityShiftAssignment[]

  @@index([role], map: "users_role_idx")
  @@index([supervisorId], map: "users_supervisorId_idx")
  @@index([departmentId], map: "users_departmentId_idx")
  @@map("users")
}

model Department {
  id         String   @id @default(cuid())
  name       String   @unique
  supervised Boolean  @default(false)
  approvalMode String @default("DIRECT") // DIRECT | GA | DEPARTMENT_HEAD
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]

  @@map("departments")
}

model Spl {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  totalHours  Float
  reason      String
  signature   String? // Tanda tangan pemohon
  projectName String?
  proofImage  String? // Foto bukti pengerjaan lembur
  actualStartAt DateTime?
  actualEndAt   DateTime?
  actualTotalHours Float?
  realizationNote String?
  realizationProofImage String?
  overrunReason String?
  regularStartAt DateTime?
  regularEndAt   DateTime?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  realizedMinutes Int?
  realizationCounted Boolean?
  realizationCancelReason String?

  // Status: PENDING_SUPERVISOR, PENDING_MANAGER, APPROVED, REJECTED_BY_SUPERVISOR, REJECTED_BY_MANAGER
  status String @default("PENDING_SUPERVISOR")

  // Approval Level 1: Supervisor (GA/Department Head)
  supervisorId              String?
  supervisor                User?     @relation("supervisor", fields: [supervisorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supervisorApprovalDate    DateTime?
  supervisorSignature       String? // Tanda tangan supervisor
  supervisorRejectionReason String?

  // Approval Level 2: Manager (existing)
  approverId      String?
  approver        User?     @relation("approver", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvalDate    DateTime?
  rejectionReason String? // Alasan penolakan manager

  // Manual Entry (by Super Admin)
  isManualEntry     Boolean   @default(false)
  manualEntryBy     String? // Super Admin ID yang buat manual entry
  requesterSignedAt DateTime? // Waktu user sign manual SPL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId, createdAt], map: "spls_requesterId_createdAt_idx")
  @@index([status, createdAt], map: "spls_status_createdAt_idx")
  @@index([supervisorId, createdAt], map: "spls_supervisorId_createdAt_idx")
  @@index([isManualEntry, requesterSignedAt], map: "spls_manual_unsigned_idx")
  @@map("spls")
}

model SecurityShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workDate  DateTime
  shiftCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate], map: "security_shift_user_date_unique")
  @@index([workDate], map: "security_shift_workDate_idx")
  @@index([shiftCode], map: "security_shift_code_idx")
  @@map("security_shift_assignments")
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@map("user_notifications")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
