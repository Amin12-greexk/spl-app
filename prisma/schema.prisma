generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  password                 String
  name                     String
  role                     String                    @default("STAFF")
  departmentName           String?                   @map("department")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  pin                      String
  position                 String?
  supervisorId             String?
  departmentId             String?
  regularStartTime         String?
  regularEndTime           String?
  image                    String?
  securityShiftAssignments SecurityShiftAssignment[]
  splApprovals             Spl[]                     @relation("approver")
  splRequests              Spl[]                     @relation("requester")
  splSupervisorApprovals   Spl[]                     @relation("supervisor")
  notifications            UserNotification[]
  department               Department?               @relation(fields: [departmentId], references: [id])
  supervisor               User?                     @relation("SupervisorRelation", fields: [supervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates             User[]                    @relation("SupervisorRelation")

  @@index([role])
  @@index([supervisorId])
  @@index([departmentId])
  @@map("users")
}

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  supervised   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  approvalMode String   @default("DIRECT")
  users        User[]

  @@map("departments")
}

model Spl {
  id                        String    @id @default(cuid())
  requesterId               String
  date                      DateTime
  startTime                 String
  endTime                   String
  totalHours                Float
  reason                    String
  projectName               String?
  status                    String    @default("PENDING_SUPERVISOR")
  approverId                String?
  approvalDate              DateTime?
  rejectionReason           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  signature                 String?
  supervisorId              String?
  supervisorApprovalDate    DateTime?
  supervisorSignature       String?
  supervisorRejectionReason String?
  proofImage                String?
  isManualEntry             Boolean   @default(false)
  manualEntryBy             String?
  requesterSignedAt         DateTime?
  actualStartAt             DateTime?
  actualEndAt               DateTime?
  actualTotalHours          Float?
  realizationNote           String?
  realizationProofImage     String?
  overrunReason             String?
  regularStartAt            DateTime?
  regularEndAt              DateTime?
  plannedStartAt            DateTime?
  plannedEndAt              DateTime?
  realizedMinutes           Int?
  realizationCounted        Boolean?
  realizationCancelReason   String?
  source                    String    @default("SYSTEM")
  // --- Dual-mode (Auto + Manual) overtime, additive & backward compatible ---
  // How the REQUEST was input: "MANUAL" (legacy default) or "AUTO".
  inputMode                 String?   @default("MANUAL")
  // How REALIZATION was computed: "MANUAL" or "AUTO_FINGER" (null = not realized yet).
  realizationSource         String?
  // Optional user-provided estimated finish (Auto mode plan). Plan only, not realization.
  plannedEstimatedEndAt     DateTime?
  // Set when fingerprint data finalized the realization.
  fingerprintMatchedAt      DateTime?
  approver                  User?     @relation("approver", fields: [approverId], references: [id])
  requester                 User      @relation("requester", fields: [requesterId], references: [id])
  supervisor                User?     @relation("supervisor", fields: [supervisorId], references: [id])

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([supervisorId, createdAt])
  @@index([isManualEntry, requesterSignedAt], map: "spls_manual_unsigned_idx")
  @@map("spls")
}

model SecurityShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  workDate  DateTime
  shiftCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate], map: "security_shift_user_date_unique")
  @@index([workDate], map: "security_shift_workDate_idx")
  @@index([shiftCode], map: "security_shift_code_idx")
  @@map("security_shift_assignments")
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("user_notifications")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Append-only audit trail for every SPL status change / important mutation.
// Intentionally FK-less so history survives hard-deletes of an Spl/User.
model SplAuditLog {
  id        String   @id @default(cuid())
  splId     String
  actorId   String?
  oldStatus String?
  newStatus String?
  source    String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([splId, createdAt])
  @@index([actorId, createdAt])
  @@map("spl_audit_logs")
}
