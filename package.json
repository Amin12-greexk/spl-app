{
  "name": "spl-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:clear": "npx tsx prisma/clear-data.ts",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:dump": "node scripts/export-postgres.js",
    "db:restore": "node scripts/restore-postgres.js",
    "db:compare": "node scripts/compare-postgres.js",
    "dokploy:postgres:create": "node scripts/dokploy-create-postgres.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^4.16.2",
    "@sanity/client": "^7.22.1",
    "@types/xlsx": "^0.0.35",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "firebase": "^10.7.1",
    "firebase-admin": "^11.11.1",
    "gsap": "^3.14.2",
    "jose": "^4.15.9",
    "next": "13.5.6",
    "next-auth": "^4.24.7",
    "next-pwa": "^5.6.0",
    "next-sanity": "^13.1.1",
    "pdf-lib": "^1.17.1",
    "prisma": "^4.16.2",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-joyride": "^2.9.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.7.0",
    "sanity": "^3.99.0",
    "sharp": "^0.34.5",
    "styled-components": "^6.4.3",
    "sweetalert2": "^11.10.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "13.5.6",
    "postcss": "^8",
    "tailwindcss": "^3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
