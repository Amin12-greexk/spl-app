# Optional extra env file for the migration helpers.
# Usage:
#   $env:MIGRATION_ENV_FILE="deployment/dokploy/migration.env.example"
#   node scripts/export-postgres.js

# Source database. If omitted, scripts fall back to DATABASE_URL from .env.
SOURCE_DATABASE_URL=

# Target database in Dokploy / Hostinger.
TARGET_DATABASE_URL=

# Dump / restore options
PG_DUMP_OUTPUT=backups/pgdump-cutover.dump
PG_RESTORE_INPUT=backups/pgdump-cutover.dump
PG_RESTORE_JOBS=1
PG_CLIENT_IMAGE=postgres:17

# Dokploy API automation
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_ENVIRONMENT_ID=
DOKPLOY_SERVER_ID=
DOKPLOY_POSTGRES_NAME=spl-postgres
DOKPLOY_POSTGRES_DB=spldb
DOKPLOY_POSTGRES_USER=splapp
DOKPLOY_POSTGRES_PASSWORD=
# Optional if you want to connect from Vercel over the public internet.
DOKPLOY_POSTGRES_EXTERNAL_PORT=5432
DOKPLOY_POSTGRES_IMAGE=postgres:16
